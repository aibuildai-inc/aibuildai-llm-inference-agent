# Build artifacts
*.egg-info/
dist/
# The Web display frontend ships its built dist as a committed generated
# tree (regenerated by `npm run build` on any frontend change); only the
# package manager's tree stays local.
!output/web/frontend/dist/
output/web/frontend/node_modules/
build/
*.tar.gz
aibuildai-linux-x86_64-*/
startup/_plugin_bundle/
# Build-time resource bundles (scripts/build_resource_bundle.py writes these into
# the frozen tree; never committed to source — same as the plugin bundle above).
engine/work_unit/agent/prompt/_resource_bundle.py
memory/_resource_bundle.py
# Build-time version injection (release.sh writes this into the frozen tree).
_version.py

