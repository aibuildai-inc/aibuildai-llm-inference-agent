assets/PiEvolve-grades.json
# Generated by `pip install -e .` — package metadata, regenerated on every install.
/aibuildai.egg-info/

# Archives
*.zip

# Scripts contain hardcoded local paths — not for public repo.
# Use `scripts/*` (not `scripts/`) so file-level `!` exceptions for tracked
# build infrastructure (e.g. build_plugin_bundle.py) take effect — git
# refuses to re-include a file if its parent directory is excluded.
scripts/*
!scripts/build_plugin_bundle.py
!scripts/build_resource_bundle.py
!scripts/check_agent_public_members.py
!scripts/check_lock_drift.py
!scripts/check_search_local_vocabulary.py
!scripts/check_skill_examples.py
!scripts/cython_compile_tree.py

# Plugins: re-include scripts/ and references/ dirs ignored by generic rules above
!plugins/**/scripts/
!plugins/**/scripts/**
!plugins/**/references/
!plugins/**/references/**

# git worktrees for sequential discipline waves
.worktrees/


# benchmarking/design is an independent git repo (Designer Evaluator benchmark)
# See benchmarking/design/research.md for reproducibility protocol
benchmarking/design/

# Locally generated run artifacts -- never committed, but they dirty `git status`,
# which makes a `git pull` look like it dumped files.
snapshot_report.html

# The PUBLIC binary-only repo (aibuildai/AI-Build-AI) cloned inside this source tree.
# It is a separate git repo; it is not part of this one.
AI-Build-AI/

# OS metadata files. Finder writes .DS_Store into every directory it opens, so a
# contributor on macOS otherwise commits them across the tree.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

packages/conversation/src/aibuildai_conversation/_native/

# ---------------------------------------------------------------------------
# SNAPSHOT EXCEPTIONS -- this tree is a distributed source snapshot, not the
# upstream working copy. Three things upstream treats as build artefacts have
# to be tracked here, or a clone cannot install or identify itself:
#
#   _version.py   upstream is generated by the build from `git describe`; a
#                 snapshot has no .git, so without this the framework reports
#                 0.0.0+unknown (see EXCLUDED.md section "Git history").
#   _native/*     the prebuilt proxy, its identity.json and its upstream
#                 LICENSE. Building them needs the cli-proxy-api submodule at
#                 its pinned commit plus Go 1.26+; shipping them lets the build
#                 hook verify the bytes and skip Go entirely.
!_version.py
!packages/conversation/src/aibuildai_conversation/_native/
!packages/conversation/src/aibuildai_conversation/_native/cli-proxy-api
!packages/conversation/src/aibuildai_conversation/_native/identity.json
!packages/conversation/src/aibuildai_conversation/_native/LICENSE
