FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

ARG GO_VERSION=1.26.0

RUN apt-get update && apt-get install -y \
    curl wget git build-essential ca-certificates \
    libssl-dev zlib1g-dev libbz2-dev libreadline-dev uuid-dev \
    libsqlite3-dev libffi-dev liblzma-dev \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 aibuildai-build

RUN wget -q "https://dl.google.com/go/go${GO_VERSION}.linux-amd64.tar.gz" -O /tmp/go.tar.gz \
    && rm -rf /usr/local/go \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz

# Install Miniconda
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh
ENV PATH="/usr/local/go/bin:/opt/conda/bin:$PATH"

# Accept conda TOS and create build environment
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main \
    && conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r \
    && conda create -n aibuildai python=3.11 -y

# Build-only tool (NOT runtime — pyinstaller freezes the staged source tree).
# Pinned by hand because it's absent from requirements.lock.
RUN conda run -n aibuildai pip install \
    pyinstaller==6.19.0

WORKDIR /build

# Runtime deps first, from ONLY the lock file, so this layer caches as long as
# requirements.lock is unchanged. Copying the lock alone (not the whole source)
# keeps the multi-hundred-MB dependency install out of the source-change cache
# path — editing any source file no longer re-downloads every dependency.
# requirements.lock is regenerated by the command README.md documents.
COPY requirements.lock /build/requirements.lock
RUN conda run -n aibuildai pip install --no-deps -r requirements.lock

# Source code last — only changes from here down bust the cache.
COPY . /build

# Version and line are derived from `git describe` on the host (the .git dir is
# excluded from the build context by .dockerignore) and passed in. release.sh
# reads them from AIBUILDAI_BUILD_VERSION and AIBUILDAI_BUILD_LINE (the codename
# of a named line, empty on a direct line) and injects them into the frozen
# binary; without them the in-container derivation has no git/metadata and
# falls back to 0.0.0+unknown. Declared here so a version change only busts the
# build layer.
ARG AIBUILDAI_BUILD_VERSION
ENV AIBUILDAI_BUILD_VERSION=${AIBUILDAI_BUILD_VERSION}
ARG AIBUILDAI_BUILD_LINE=
ENV AIBUILDAI_BUILD_LINE=${AIBUILDAI_BUILD_LINE}

# The host reads the pinned CLIProxyAPI submodule commit before `.git` is
# removed from the build input; infra.owned_tools uses it as the build
# identity because the in-container tree has no git metadata.
ARG AIBUILDAI_CLIPROXYAPI_SOURCE_COMMIT
ENV AIBUILDAI_CLIPROXYAPI_SOURCE_COMMIT=${AIBUILDAI_CLIPROXYAPI_SOURCE_COMMIT}

# The release.sh pre-build machine gate runs pyright / ruff / semgrep — none
# present in this minimal image (semgrep cannot be installed: its mcp==1.23.3
# pin conflicts with the product's mcp). check.sh is run on the host before
# `docker build` (see README.md "Releasing"); skip the in-container gate
# explicitly.
ENV AIBUILDAI_SKIP_PRECHECK=1

# Build using conda env
RUN conda run -n aibuildai bash release.sh --no-publish

# The tarball is at /build/aibuildai-linux-x86_64-*.tar.gz
CMD ["ls", "-lh", "/build/aibuildai-linux-x86_64-*.tar.gz"]
